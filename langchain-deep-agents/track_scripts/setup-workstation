"""Tiny helper: record that a notebook cell really ran, for the challenge Check."""

import os
from pathlib import Path


def mark_done(path):
    """Write a sentinel the Check reads, tolerating one root already left there."""
    p = Path(path)
    try:
        p.write_text("ok\n")
    except PermissionError:
        # Skipping a challenge runs its solve as root, which creates these
        # files; /tmp is sticky so we cannot replace one we do not own. If it
        # is already present with content, the Check is satisfied either way.
        if not (p.exists() and p.read_text().strip()):
            raise
        return
    try:
        os.chmod(p, 0o666)  # let root-side scripts rewrite it later
    except OSError:
        pass

