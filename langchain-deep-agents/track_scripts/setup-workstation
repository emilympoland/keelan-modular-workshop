load_dotenv("/root/workshop/.env", override=True)
# Warm-up calls must NOT trace — they'd land as root runs in the learner's
# project before the learner has run anything.
os.environ["LANGSMITH_TRACING"] = "false"
sys.path.insert(0, "/root/workshop")
from utils.models import model

ok = False
for attempt in range(12):
    try:
        model.invoke("Reply with the single word: ready")
        print(f"warmup sonnet: ok (attempt {attempt + 1})")
        ok = True
        break
    except Exception as exc:
        print(f"warmup sonnet: attempt {attempt + 1} failed: {str(exc)[:140]}")
        time.sleep(15)
if not ok:
    print(f"WARMUP INCOMPLETE — model id: {model.model_id}")
    sys.exit(1)
