"""Print the link to this sandbox's LangSmith project, and what to open there."""

import os

from langchain_core.tracers.langchain import wait_for_all_tracers
from langsmith import Client


def project_link(run_name=None, expand=None):
    """Print the project URL. Name a run to say which one to open."""
    if not os.environ.get("LANGSMITH_API_KEY"):
        return  # no LangSmith key: tracing is off, so there is no link
    # Push any queued spans before we go looking for them. NOTE this flushes the
    # client queue; it is not a read-after-write barrier -- LangSmith is still
    # eventually consistent, which is why the Checks retry.
    wait_for_all_tracers()

    # The UI host mirrors the API host for your region -- api.smith -> smith,
    # eu.api.smith -> eu.smith, and so on. Dropping "api." is the whole mapping.
    # `or` rather than a get() default: the variable is always PRESENT in the
    # sandbox, and is empty for a US-region key, which a default never catches.
    api = os.environ.get("LANGSMITH_ENDPOINT") or "https://api.smith.langchain.com"
    ui = api.replace("api.smith", "smith")
    project = os.environ["LANGSMITH_PROJECT"]

    try:
        p = Client().read_project(project_name=project)
        print("Your traces:")
        print(f"  {ui}/o/{p.tenant_id}/projects/p/{p.id}")
    except Exception:
        # Never print the error body: a credential failure can echo the key back.
        print(f"Open {ui} and choose project:", project)

    if run_name:
        print()
        print(f"Open '{run_name}'" + (f" and expand '{expand}'." if expand else "."))


def trace_link(run_id):
    """Print the URL of one trace. Pass the run_id given to invoke() in config."""
    if not os.environ.get("LANGSMITH_API_KEY"):
        return  # no LangSmith key: tracing is off, so there is no link
    wait_for_all_tracers()

    api = os.environ.get("LANGSMITH_ENDPOINT") or "https://api.smith.langchain.com"
    ui = api.replace("api.smith", "smith")
    project = os.environ["LANGSMITH_PROJECT"]

    try:
        p = Client().read_project(project_name=project)
        # ?poll=true: the page waits for the trace if it hasn't landed yet.
        print(f"\nView the trace: {ui}/o/{p.tenant_id}/projects/p/{p.id}/r/{run_id}?poll=true")
    except Exception:
        # Never print the error body: a credential failure can echo the key back.
        print(f"\nOpen {ui} and choose project:", project)
