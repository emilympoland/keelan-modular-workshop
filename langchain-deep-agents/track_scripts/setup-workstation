#!/bin/bash
#
# Track-level setup — langchain-deep-agents-workshop-ext
#
# Provisions the workshop environment on the workstation VM:
#   repo (pinned) + uv venv, Bedrock model wiring, setup notebook,
#   JupyterLab behind nginx (systemd), Bedrock warm-up.
#
# The track provides NO LangSmith credentials: learners enter their
# own in challenge 1. The only credential here is the per-sandbox AWS account
# Instruqt provisions for Bedrock.
#
# Infra conventions lifted from the sibling track
# langchain-langgraph-langsmith-ext (git branch adlc-101-slice-0). AgentCore
# Web Search was tried and rejected as the section-3 web-search tool -- see
# MEMORY.md, slice 0 verdict: blocked by an AWS Organizations SCP deny.
#
set -euxo pipefail
PS4='+$0[$LINENO]+'

echo "##################################################"
echo "# running track_scripts/setup-workstation        #"
echo "##################################################"

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export HOME=/root

# The workshop tree lives in /opt/workshop, owned by the non-root 'workshop'
# user that runs JupyterLab. /root/workshop is a compatibility symlink so every
# path used by checks, solves, and notebooks keeps working.
WORKSHOP_DIR=/opt/workshop
WORKSHOP_USER=workshop
INSTRUQT_DIR="${WORKSHOP_DIR}/instruqt"
OPS_DIR=/opt/instruqt-workshop
ENV_FILE=/etc/instruqt-workshop.env

# ---------------------------------------------------------------- #
echo "⏳ Step 1/10: waiting for host bootstrap + agent..."
tries=0
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  tries=$((tries+1)); [ "$tries" -ge 300 ] && { echo "SETUP FAILED: bootstrap sentinel absent after 300s" >&2; exit 1; }
  sleep 1
done
tries=0
until ss -tuln 2>/dev/null | grep -q ':15779'; do
  tries=$((tries+1)); [ "$tries" -ge 120 ] && { echo "SETUP FAILED: instruqt agent port 15779 not up after 120s" >&2; exit 1; }
  sleep 1
done
echo "✅ Step 1/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 2/10: base packages..."
wait_for_dpkg() {
  local t=0
  while fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock >/dev/null 2>&1; do
    t=$((t+1)); [ "$t" -ge 150 ] && { echo "SETUP FAILED: dpkg lock held >300s" >&2; exit 1; }
    sleep 2
  done
}
wait_for_dpkg
apt-get update -qq
wait_for_dpkg
apt-get install -y -qq git jq curl unzip nginx
touch /root/.hushlogin

# Non-root service account for JupyterLab (no login shell, so Jupyter's
# terminal feature is dead weight even if reached).
id -u "$WORKSHOP_USER" >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin "$WORKSHOP_USER"
echo "✅ Step 2/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 3/10: per-sandbox identity + agent variables..."
# The sandbox id is the uniqueness guarantee: Instruqt documents
# INSTRUQT_PARTICIPANT_ID (which _SANDBOX_ID mirrors) as unique for every play.
#
# It is NOT attributable, though, which matters when a room shares one LangSmith
# workspace. Instruqt's INSTRUQT_USER_NAME / INSTRUQT_USER_EMAIL would solve
# that, but both are gated on the user having accepted the org's privacy policy
# and team `langchain` has none configured -- a real playthrough on 2026-09-16
# showed both EMPTY with PRIVACY_POLICY_CONSENT unset, so no track-side code can
# reach them. The learner supplies their own label in challenge 1 instead, which
# is also the only option that works for external customers. See MEMORY.md.
SFX="$(echo "${_SANDBOX_ID:-localdev0}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9' | cut -c1-8)"
[ -n "$SFX" ] || SFX="localdev"
LS_PROJECT="${LANGSMITH_PROJECT_BASE:-instruqt-deep-agents}-${SFX}"

agent variable set SFX "$SFX"
agent variable set LS_PROJECT "$LS_PROJECT"
echo "✅ Step 3/10 completed (suffix: ${SFX})"

echo "⏳ Step 4/10: clone modular-workshops @ pinned commit..."
# Pinned to WORKSHOP_COMMIT (config.yml) so upstream changes never break a
# workshop that is already running.
rm -rf "$WORKSHOP_DIR"
mkdir -p "$WORKSHOP_DIR"
cd "$WORKSHOP_DIR"
git init -q
git remote add origin "${WORKSHOP_REPO}"
tries=0
until git fetch --depth 1 origin "${WORKSHOP_COMMIT}"; do
  tries=$((tries+1)); [ "$tries" -ge 5 ] && { echo "SETUP FAILED: could not fetch pinned commit from GitHub" >&2; exit 1; }
  sleep 5
done
git checkout -q FETCH_HEAD
mkdir -p "${WORKSHOP_DIR}/output" "$INSTRUQT_DIR" "$OPS_DIR"
# Compatibility symlink: /root/workshop → /opt/workshop
[ -L /root/workshop ] || rm -rf /root/workshop
ln -sfn "$WORKSHOP_DIR" /root/workshop
# The non-root 'workshop' user (Jupyter kernels) must traverse /root to reach
# that symlink. 711 allows traverse-by-known-name only — no directory listing,
# and the sensitive files under /root (.aws/credentials, .ssh keys) stay 600
# and unreadable.
chmod 711 /root
echo "✅ Step 4/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 5/10: uv + python environment (uv sync)..."
# The pinned commit's pyproject.toml already carries every dependency this
# track needs (langgraph, langgraph-checkpoint-sqlite, langgraph-cli, jupyter,
# langchain-aws, tavily-python, python-dotenv, and -- as the default `harbor`
# dependency group -- challenge 13's harbor CLI), so a plain `uv sync` is
# sufficient — no supplementary installs that could drift from upstream.
if ! command -v uv >/dev/null 2>&1 && [ ! -x /root/.local/bin/uv ]; then
  tries=0
  until curl -LsSf https://astral.sh/uv/install.sh | sh; do
    tries=$((tries+1)); [ "$tries" -ge 3 ] && { echo "SETUP FAILED: uv install failed 3x" >&2; exit 1; }
    sleep 5
  done
fi
export PATH="/root/.local/bin:$PATH"
cd "$WORKSHOP_DIR"
tries=0
until uv sync; do
  tries=$((tries+1)); [ "$tries" -ge 3 ] && { echo "SETUP FAILED: uv sync failed 3x" >&2; exit 1; }
  sleep 10
done
VENV_PY="${WORKSHOP_DIR}/.venv/bin/python"
echo "✅ Step 5/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 6/10: credentials + environment files..."
# Secrets go into files, never into the xtrace log -- so xtrace goes off before
# the key and secret are even read into variables, or every assignment below
# would print them.
set +x
# Resolve Bedrock AWS creds; fall back to any injected AWS-account prefix.
BEDROCK_AWS_KEY="${INSTRUQT_AWS_ACCOUNT_BEDROCK_AWS_ACCESS_KEY_ID:-}"
BEDROCK_AWS_SECRET="${INSTRUQT_AWS_ACCOUNT_BEDROCK_AWS_SECRET_ACCESS_KEY:-}"
if [ -z "$BEDROCK_AWS_KEY" ]; then
  key_var="$(env | grep -oE '^INSTRUQT_AWS_ACCOUNT_[A-Z0-9_]+_AWS_ACCESS_KEY_ID' | head -n1 || true)"
  if [ -n "$key_var" ]; then
    secret_var="${key_var%_AWS_ACCESS_KEY_ID}_AWS_SECRET_ACCESS_KEY"
    BEDROCK_AWS_KEY="${!key_var}"
    BEDROCK_AWS_SECRET="${!secret_var}"
  fi
fi
[ -n "$BEDROCK_AWS_KEY" ] || { echo "SETUP FAILED: no injected AWS credentials found for Bedrock" >&2; exit 1; }
# No LangSmith key is expected here: the learner supplies their own in
# challenge 1, and the getpass cell appends them to the .env written below.

mkdir -p /root/.aws
cat > /root/.aws/credentials <<AWSEOF
[default]
aws_access_key_id = ${BEDROCK_AWS_KEY}
aws_secret_access_key = ${BEDROCK_AWS_SECRET}
AWSEOF
cat > /root/.aws/config <<AWSCFGEOF
[default]
region = ${BEDROCK_REGION}
AWSCFGEOF
chmod 600 /root/.aws/credentials

# Workshop .env — loaded by utils/models.py (dotenv) and every notebook.
#
# Ships WITHOUT a LangSmith key: the learner adds it in challenge 1
# and the getpass cell rewrites this file in place. Tracing starts off, so the
# tracer doesn't emit errors against a key that doesn't exist yet; the same cell
# flips it on once a key has authenticated.
#
# No LANGSMITH_WORKSPACE_ID either — the learner's key belongs to their own
# workspace, and scoping clients to ours would make every call forbidden.
cat > "${WORKSHOP_DIR}/.env" <<DOTENVEOF
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=${LS_PROJECT}
WORKSHOP_SFX=${SFX}
WORKSHOP_PROJECT_BASE=${LANGSMITH_PROJECT_BASE:-instruqt-deep-agents}
AWS_ACCESS_KEY_ID=${BEDROCK_AWS_KEY}
AWS_SECRET_ACCESS_KEY=${BEDROCK_AWS_SECRET}
AWS_DEFAULT_REGION=${BEDROCK_REGION}
BEDROCK_MODEL_SONNET=${BEDROCK_MODEL_SONNET}
BEDROCK_MODEL_HAIKU=${BEDROCK_MODEL_HAIKU}
DOTENVEOF
chmod 600 "${WORKSHOP_DIR}/.env"

# Same content for systemd services + interactive shells.
cp "${WORKSHOP_DIR}/.env" "$ENV_FILE"
# Per-sandbox JupyterLab token (ENV_FILE only — not in the learner-visible
# .env). nginx injects it for tab traffic; Jupyter refuses anything without it.
JUPYTER_TOKEN="$(openssl rand -hex 24)"
echo "JUPYTER_TOKEN=${JUPYTER_TOKEN}" >> "$ENV_FILE"
chmod 600 "$ENV_FILE"
cat >> /root/.bashrc <<'BASHRCEOF'
set -a; [ -f /etc/instruqt-workshop.env ] && . /etc/instruqt-workshop.env; set +a
export PATH="/root/.local/bin:/root/workshop/.venv/bin:$PATH"
BASHRCEOF
set -x

echo "✅ Step 6/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 7/10: point utils/models.py at Bedrock..."
# Deterministic overwrite (not sed) — same public interface: `model`.
# This is also what resolves the import-time credential problem: the module
# that reads the environment is replaced wholesale.
cat > "${WORKSHOP_DIR}/utils/models.py" <<'MODELSEOF'
"""Centralized model initialization (Instruqt build).

The notebooks all import `model` from here. This build runs on AWS Bedrock
using the sandbox's ephemeral AWS credentials — the documented one-line
provider swap from the upstream repo, applied.
"""

import os
from dotenv import load_dotenv
load_dotenv(dotenv_path="../.env", override=True)
load_dotenv(dotenv_path="/root/workshop/.env", override=False)

from langchain_aws import ChatBedrockConverse

_REGION = os.environ.get("AWS_DEFAULT_REGION", "us-east-1")

# Agent model — Claude Sonnet via Bedrock cross-region inference.
model = ChatBedrockConverse(
    provider="anthropic",
    model_id=os.environ.get("BEDROCK_MODEL_SONNET", "us.anthropic.claude-sonnet-4-6"),
    region_name=_REGION,
)

# Judge model — Claude Haiku, for fast/cheap evaluation work.
judge_model = ChatBedrockConverse(
    provider="anthropic",
    model_id=os.environ.get("BEDROCK_MODEL_HAIKU", "us.anthropic.claude-haiku-4-5-20251001-v1:0"),
    region_name=_REGION,
)

# Same agent model as data, for challenge 13's Harbor job: the trial container
# can't import this file, so the spec travels through Harbor's config channel
# (upstream's MODEL_SPEC / API_KEY_ENV interface). Bedrock authenticates from
# the AWS credential chain, so there's no single key variable.
MODEL_SPEC = {
    "model": "bedrock_converse:" + os.environ.get("BEDROCK_MODEL_SONNET", "us.anthropic.claude-sonnet-4-6"),
    "region_name": _REGION,
}
API_KEY_ENV = None

# Without a LangSmith key there are no traces for the challenge Checks to read,
# so record each run to local disk instead -- the same tree LangSmith would hold
# (tool and model inputs/outputs), one JSON file per invoke(). With a key this
# block does nothing and LangSmith stays the only record.
if not os.environ.get("LANGSMITH_API_KEY"):
    import json
    from contextvars import ContextVar
    from pathlib import Path

    from langchain_core.tracers.base import BaseTracer
    from langchain_core.tracers.context import register_configure_hook

    _TRACE_DIR = Path("/var/lib/lab-traces")

    def _flatten(run, out):
        out.append({
            "id": str(run.id), "trace_id": str(run.trace_id),
            "parent_run_id": str(run.parent_run_id) if run.parent_run_id else None,
            "name": run.name, "run_type": run.run_type,
            "start_time": run.start_time.isoformat(),
            "inputs": run.inputs, "outputs": run.outputs, "error": run.error,
        })
        for child in run.child_runs:
            _flatten(child, out)
        return out

    class _LocalTraceRecorder(BaseTracer):
        def _persist_run(self, run):
            path = _TRACE_DIR / f"{run.id}.json"
            path.write_text(json.dumps(_flatten(run, []), default=str))

    register_configure_hook(ContextVar("lab_local_tracer", default=None), True,
                            _LocalTraceRecorder, "LAB_LOCAL_TRACES")
    os.environ["LAB_LOCAL_TRACES"] = "true"
MODELSEOF
# Challenge 13's Harbor trial container installs its own dependencies from this
# file, and upstream lists only langchain-openai. The track's MODEL_SPEC is
# bedrock_converse, so the container needs langchain-aws too.
"$VENV_PY" - <<'LGJSONEOF'
import json
from pathlib import Path

p = Path("/opt/workshop/environment_evals/deep-agent/langgraph.json")
cfg = json.loads(p.read_text())
if not any(d.startswith("langchain-aws") for d in cfg["dependencies"]):
    cfg["dependencies"].append("langchain-aws>=1.6")
p.write_text(json.dumps(cfg, indent=2) + "\n")
LGJSONEOF

# ---- web search: LangSmith's managed Parallel search ----
# The same server Managed Deep Agents projects add with define_mcp(...)
# (docs.langchain.com/langsmith/python/managed-deep-agents-search), called
# directly over MCP's HTTP transport with the learner's own LangSmith key, since
# these agents run in notebooks rather than as a managed project. Confirmed
# working outside a managed project on 2026-10-07: x-api-key + X-Tenant-Id
# headers, one tool, `parallel_web_search(objective, search_queries)`.
#
# Replaces Tavily, so learners need no search key at all. Keeps upstream's
# resilience contract: retries, then upstream's topic-matched canned fallback
# (reused from utils/search.py) under the same "[fallback content; ...]" marker.
cat > "${WORKSHOP_DIR}/utils/parallel_search.py" <<'PSEARCHEOF'
"""Web search through LangSmith's managed Parallel search, with retries and a
canned fallback.

Usage, from inside your own `@tool` (same shape as upstream's Tavily helper):

    from utils.parallel_search import resilient_parallel_search

    @tool(parse_docstring=True)
    def web_search(query: str) -> str:
        \"\"\"Search the web for information on a given query.

        Args:
            query: Search query to execute.
        \"\"\"
        return resilient_parallel_search(query, max_retries=2)

Authenticates with LANGSMITH_API_KEY; no Parallel key. Without a LangSmith key,
or if every attempt fails, returns canned results so the agent can still answer.
"""

from __future__ import annotations

import json
import os
import threading
import time
from typing import Optional

import requests

from utils.search import _pick_fallback

_PATH = "/v1/managed-tools/servers/parallel/mcp"
_TOOL = "parallel_web_search"
_PROTOCOL = "2025-06-18"

_lock = threading.Lock()
_session_id: Optional[str] = None
_workspace_id: Optional[str] = None


def _url() -> str:
    base = os.environ.get("LANGSMITH_ENDPOINT") or "https://api.smith.langchain.com"
    return base.rstrip("/") + _PATH


def _workspace() -> Optional[str]:
    """The key's workspace ID, looked up once. The server reads it from X-Tenant-Id."""
    global _workspace_id
    if _workspace_id is None:
        _workspace_id = os.environ.get("LANGSMITH_WORKSPACE_ID", "")
        if not _workspace_id:
            from langsmith import Client

            project = next(iter(Client().list_projects(limit=1)), None)
            _workspace_id = str(project.tenant_id) if project else ""
    return _workspace_id or None


def _post(payload: dict, session: Optional[str] = None) -> requests.Response:
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
        "x-api-key": os.environ["LANGSMITH_API_KEY"],
    }
    workspace = _workspace()
    if workspace:
        headers["X-Tenant-Id"] = workspace
    if session:
        headers["Mcp-Session-Id"] = session
    resp = requests.post(_url(), json=payload, headers=headers, timeout=60)
    resp.raise_for_status()
    return resp


def _message(resp: requests.Response) -> dict:
    """A JSON-RPC message from a plain JSON body or an SSE `data:` stream."""
    body = resp.text
    for line in body.splitlines():
        if line.startswith("data:"):
            body = line[5:].strip()
    return json.loads(body)


def _session() -> str:
    """Open the MCP session once per process; reused across calls and threads."""
    global _session_id
    with _lock:
        if _session_id is None:
            resp = _post({
                "jsonrpc": "2.0", "id": 1, "method": "initialize",
                "params": {"protocolVersion": _PROTOCOL, "capabilities": {},
                           "clientInfo": {"name": "instruqt-workshop", "version": "1"}},
            })
            sid = resp.headers.get("Mcp-Session-Id")
            _post({"jsonrpc": "2.0", "method": "notifications/initialized"}, sid)
            _session_id = sid or ""
        return _session_id


def _reset_session() -> None:
    global _session_id
    with _lock:
        _session_id = None


def _search(query: str, max_results: int) -> str:
    msg = _message(_post({
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {"name": _TOOL,
                   "arguments": {"objective": query, "search_queries": [query]}},
    }, _session() or None))
    if "error" in msg:
        raise RuntimeError(msg["error"].get("message", "MCP error"))
    result = msg["result"]
    text = "".join(c.get("text", "") for c in result.get("content", []) if c.get("type") == "text")
    if result.get("isError"):
        raise RuntimeError(text[:200] or "search failed")

    try:
        hits = json.loads(text).get("results", [])
    except ValueError:
        return text[:6000]
    if not hits:
        raise RuntimeError("Parallel returned 0 results")
    # Same layout as upstream's Tavily helper: **title**, url, content.
    return "\n\n".join(
        f"**{h.get('title') or h.get('url', '')}**\n{h.get('url', '')}\n"
        + "\n".join(h.get("excerpts") or [])[:1500]
        for h in hits[:max_results]
    )


def resilient_parallel_search(
    query: str,
    *,
    max_retries: int = 2,
    max_results: int = 5,
    base_backoff_seconds: float = 1.0,
) -> str:
    """Run a Parallel web search with retries; fall back to canned content on failure.

    Args:
        query: search query to run (also sent as the search objective).
        max_retries: additional attempts after the first call.
        max_results: how many results to return.
        base_backoff_seconds: first retry sleeps this long; then `base * attempt`.
    """
    if not os.environ.get("LANGSMITH_API_KEY"):
        last_error: Exception = RuntimeError("no LangSmith key")
    else:
        for attempt in range(max_retries + 1):
            try:
                return _search(query, max_results)
            except Exception as exc:
                last_error = exc
                _reset_session()
                if attempt < max_retries:
                    time.sleep(base_backoff_seconds * (attempt + 1))

    notice = (
        f"[fallback content; live search unavailable -- "
        f"{type(last_error).__name__}: {str(last_error)[:120]}]\n\n"
    )
    return notice + _pick_fallback(query)
PSEARCHEOF

# Point upstream's two shared agents at the same search, so challenges 9, 11,
# 12 and 14 match 3-7. deep_agent names its tool parallel_search, not
# web_search: it already has a local variable called web_search.
"$VENV_PY" - <<'AGENTSEARCHEOF'
from pathlib import Path

def patch(path, pairs):
    p = Path(path)
    s = p.read_text()
    for old, new in pairs:
        if old not in s:
            raise SystemExit(f"SETUP FAILED: {path} no longer contains {old!r}")
        s = s.replace(old, new)
    p.write_text(s)

patch("/opt/workshop/agents/research_agent.py", [
    ("from utils.search import resilient_tavily_search",
     "from utils.parallel_search import resilient_parallel_search"),
    ("resilient_tavily_search(query, max_retries=2)",
     "resilient_parallel_search(query, max_retries=2)"),
    ("`resilient_tavily_search` retries on Tavily failure",
     "`resilient_parallel_search` retries on failure"),
    ("tavily_search", "web_search"),
])
patch("/opt/workshop/agents/deep_agent/agent.py", [
    ("from utils.search import resilient_tavily_search",
     "from utils.parallel_search import resilient_parallel_search"),
    ("resilient_tavily_search(query, max_retries=2)",
     "resilient_parallel_search(query, max_retries=2)"),
    ("def tavily_search(", "def parallel_search("),
    ("else tavily_search", "else parallel_search"),
])
print("agents now search through LangSmith's managed Parallel search")
AGENTSEARCHEOF

# World-writable + sticky, like /tmp: the Jupyter kernel (workshop user) and
# the solve scripts (root) both write here; the Checks (root) read.
mkdir -p /var/lib/lab-traces
chmod 1777 /var/lib/lab-traces
# ---- Bedrock credential preflight --------------------------------- #
# Runs after models.py is rewritten above: before that, utils/models.py is
# upstream's OpenAI wiring and this always failed.
# The model is the only credential the TRACK provides, so it is the only one
# that can be validated here. The learner's LangSmith key is
# validated at the moment they are entered, in the challenge-1 notebook cell.
cat > "${OPS_DIR}/preflight_bedrock.py" <<'PREEOF'
"""Fail fast if the sandbox's injected AWS credentials cannot reach Bedrock."""
import os, sys
from dotenv import load_dotenv
load_dotenv("/root/workshop/.env", override=True)
sys.path.insert(0, "/root/workshop")

try:
    from utils.models import model
    model.invoke("Reply with the single word: ready")
except Exception as exc:
    print("SETUP FAILED: Bedrock credential preflight", file=sys.stderr)
    print("  The sandbox's AWS credentials could not invoke the model.", file=sys.stderr)
    print(f"  region: {os.environ.get('AWS_DEFAULT_REGION')}", file=sys.stderr)
    print(f"  model:  {os.environ.get('BEDROCK_MODEL_SONNET')}", file=sys.stderr)
    print(f"  API said: {str(exc)[:200]}", file=sys.stderr)
    sys.exit(1)
print("\u2713 preflight OK \u2014 Bedrock reachable with the sandbox's AWS credentials")
PREEOF
# Guarded: Bedrock model access can take minutes to finish enabling in a fresh
# sandbox, so a failure here is reported by the warm-up retry loop in step 10
# rather than killing setup on the first attempt.
"$VENV_PY" "${OPS_DIR}/preflight_bedrock.py" || echo "preflight: Bedrock not ready yet — step 10 retries with backoff"
echo "✅ Step 7/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 8/10: workshop content (verify script, orientation notebook)..."

# ---- verify-connection (challenge 1) ----
# Reads whatever key the learner stored via the notebook's getpass cell.
# Prints NO part of the key — the PRD forbids any secret value, even a prefix,
# in learner-facing output.
cat > "${OPS_DIR}/verify_connection.py" <<'VERIFYEOF'
"""Challenge 1 — verify the LangSmith connection, live."""
import os, sys
from dotenv import load_dotenv
load_dotenv("/root/workshop/.env", override=True)
from langsmith import Client

ACCENT = "\033[38;2;127;200;255m"; OK = "\033[38;2;2;122;72m"
ERR = "\033[38;2;180;35;24m"; RST = "\033[0m"

def fail(msg):
    print(f"{ERR}✗ {msg}{RST}"); sys.exit(1)

def done():
    with open("/tmp/.verify-connection-ok", "w") as f:
        f.write("ok\n")
    # Mode 666: this runs as root, but the same sentinel may later be rewritten
    # by the non-root account that runs the Jupyter kernel.
    os.chmod("/tmp/.verify-connection-ok", 0o666)

print(f"{ACCENT}── LangSmith connection check ─────────────────────{RST}")
key = os.environ.get("LANGSMITH_API_KEY", "")
if not key:
    if not os.path.exists("/tmp/.credentials-ok"):
        fail("No keys entered yet. Run the first cell of 01_setup.ipynb on the Notebook tab.")
    print("• No LangSmith key: tracing is off, so there is no connection to check.")
    print("  Every Challenge and Check still works without it.")
    done()
