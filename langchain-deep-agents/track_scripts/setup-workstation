"""Collect the learner's LangSmith key in Challenge 1 and store it in .env.

Plumbing, deliberately kept out of the notebook: nobody is here to learn
getpass. The notebook cell is just `from lab_credentials import collect`.
"""

import getpass
import os
import re
import unicodedata
from pathlib import Path

from lab_state import mark_done

ENV = Path("/root/workshop/.env")

# LangSmith is regional and a key is only valid in its own region. The region is
# NOT encoded in the key -- `lsv2_sk_` vs `lsv2_pt_` is service-key vs personal
# token, not US vs EU -- so the only way to know is to ask each region in turn.
REGIONS = [
    ("US", "https://api.smith.langchain.com"),
    ("EU", "https://eu.api.smith.langchain.com"),
    ("APAC", "https://apac.api.smith.langchain.com"),
    ("AWS US", "https://aws.api.smith.langchain.com"),
]


def _detect_region(api_key):
    """First region where the key really authenticates, as (label, endpoint).

    Uses list_projects rather than Client().info: /info is UNAUTHENTICATED and
    returns 200 for any key at all, including a garbage one, so it cannot tell
    a good key from a bad one, or the right region from the wrong one.
    """
    import itertools

    from langsmith import Client

    for label, url in REGIONS:
        try:
            client = Client(api_key=api_key, api_url=url)
            list(itertools.islice(client.list_projects(), 1))
        except Exception:
            # Never inspect or print the body: a rejected-credential response
            # can echo the submitted key back, and notebook output is saved to
            # disk. Failures here are the ordinary wrong-region path.
            continue
        return label, url
    return None, None


def _slugify(text):
    """Strip accents and punctuation so a label is safe inside a project name."""
    plain = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "", plain.lower())[:20]


def _store(updates, remove=()):
    """Rewrite .env in place at 0600, preserving every unrelated line."""
    lines = ENV.read_text().splitlines() if ENV.exists() else []
    drop = set(updates) | set(remove)
    kept = [l for l in lines if l.split("=", 1)[0] not in drop]
    body = "\n".join(kept + [f"{k}={v}" for k, v in updates.items()]) + "\n"
    fd = os.open(str(ENV), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    # The mode above only applies when the file is CREATED. .env already exists
    # (setup writes it), so without this an earlier bad mode would survive every
    # rewrite. Enforce it on the file we just wrote.
    os.chmod(str(ENV), 0o600)


def _project_name(label):
    sfx = os.environ.get("WORKSHOP_SFX", "")
    base = os.environ.get("WORKSHOP_PROJECT_BASE", "instruqt-deep-agents")
    if label and sfx:
        return f"{base}-{label}-{sfx}"
    if sfx:
        return f"{base}-{sfx}"
    return os.environ["LANGSMITH_PROJECT"]


def collect():
    """Prompt for keys, verify the LangSmith one live, and switch tracing on."""
    ls_key = getpass.getpass(
        "LangSmith API key (input hidden, or press Enter to skip): "
    ).strip()
    if not ls_key:
        # No LangSmith: tracing off, and any key from an earlier run removed so
        # every later notebook and Check agrees on which mode this sandbox is in.
        remove = ["LANGSMITH_API_KEY", "LANGSMITH_ENDPOINT"]
        updates = {"LANGSMITH_TRACING": "false"}
        _store(updates, remove)
        for k in remove:
            os.environ.pop(k, None)
        os.environ["LANGSMITH_TRACING"] = "false"
        mark_done("/tmp/.credentials-ok")
        print("✅ Stored. LangSmith skipped: tracing is OFF and no trace links are printed.")
        print("   web search returns canned results without a LangSmith key.")
        return
    if not ls_key.startswith("lsv2_"):
        raise SystemExit(
            "That doesn't look like a LangSmith key - they start with 'lsv2_'. "
            "Re-run this cell."
        )

    os.environ["LANGSMITH_API_KEY"] = ls_key

    print("Checking your key against each LangSmith region...")
    region, endpoint = _detect_region(ls_key)
    if endpoint is None:
        raise SystemExit(
            "That key did not authenticate in any LangSmith region "
            "(US, EU, APAC, AWS US). Check it and re-run this cell."
        )

    # Every LangSmith client in this track is a bare Client(), which reads this
    # variable from the environment -- so storing it here is what points the
    # tracer, verify-connection and all six Checks at your region.
    updates = {
        "LANGSMITH_API_KEY": ls_key,
        "LANGSMITH_TRACING": "true",
        "LANGSMITH_ENDPOINT": endpoint,
    }

    remove = []

    # Not a secret, so unlike the keys above this one is echoed as it is typed.
    label = _slugify(input("Short name or initials for your project (e.g. jdoe): "))
    project = _project_name(label)
    updates["LANGSMITH_PROJECT"] = project

    _store(updates, remove)
    os.environ["LANGSMITH_TRACING"] = "true"
    # The kernel started before this project name existed, so set it explicitly
    # -- every trace from here on reads the name from the environment.
    os.environ["LANGSMITH_PROJECT"] = project
    os.environ["LANGSMITH_ENDPOINT"] = endpoint
    mark_done("/tmp/.credentials-ok")

    print("✅ Key verified and stored. Tracing is ON.")
    print("   region :", region)
    print("   project:", project)
    if not label:
        print("   (no label given, so your project is named after this session)")
