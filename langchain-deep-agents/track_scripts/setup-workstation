# ---- shared credential seeder (used by solve scripts) ----
# `instruqt track test` never types into a getpass prompt, so solves call this
# instead of driving the prompt. Full-chain defensive: any solve may call it at
# any challenge, which matters because skipping_enabled is on.
cat > "${OPS_DIR}/seed_credentials.py" <<'SEEDEOF'
"""Reproduce the state challenge 1's getpass cell produces.

Two modes, and the difference matters:

  SOLVE_LANGSMITH_API_KEY present -> the real key is stored and tracing is on,
    so the Checks read the run back from LangSmith.
  absent -> no key and tracing off, exactly as a learner who pressed Enter at
    the prompt. The Checks then read the local trace files utils/models.py
    writes instead. See MEMORY.md.

BUT: a key the LEARNER already entered always wins over both of those. Skipping
a challenge runs its solve as root, and every solve calls this seeder
defensively -- so without that rule, a learner who entered a real key and later
pressed Skip would silently lose it.

Values arrive as Instruqt runtime parameters, which are injected under their own
name and are NOT persisted into the VM — they exist only for the duration of the
lifecycle script. Idempotent: rewrites the same keys, leaves other lines alone.
"""
import os
from pathlib import Path

ENV = Path("/opt/workshop/.env")

lines = ENV.read_text().splitlines() if ENV.exists() else []


def stored(name):
    """Current value of `name` in .env, or "" if absent. Never printed."""
    for line in reversed(lines):
        k, _, v = line.partition("=")
        if k == name:
            return v.strip()
    return ""


def learner_key(name, prefix):
    v = stored(name)
    return v if v.startswith(prefix) else ""

ls_real = os.environ.get("SOLVE_LANGSMITH_API_KEY", "").strip()

ls_kept = learner_key("LANGSMITH_API_KEY", "lsv2_")

# Region endpoint. Same precedence as the keys: a learner's detected endpoint
# always wins, so a Skip cannot silently move an EU learner back to the US API.
# Deliberately NOT re-probing the network here -- this seeder runs inside every
# solve, and four possible auth round-trips per solve would eat the lifecycle
# script's time budget. A test run against a non-US key passes the endpoint in
# explicitly as SOLVE_LANGSMITH_ENDPOINT.
DEFAULT_ENDPOINT = "https://api.smith.langchain.com"
ep_kept = stored("LANGSMITH_ENDPOINT")
ep_real = os.environ.get("SOLVE_LANGSMITH_ENDPOINT", "").strip()

remove = []
if ls_kept or ls_real:
    updates = {
        "LANGSMITH_API_KEY": ls_kept or ls_real,
        "LANGSMITH_TRACING": "true",
        "LANGSMITH_ENDPOINT": ep_kept or ep_real or DEFAULT_ENDPOINT,
    }
else:
    updates = {"LANGSMITH_TRACING": "false"}
    remove = ["LANGSMITH_API_KEY", "LANGSMITH_ENDPOINT"]
drop = set(updates) | set(remove)
kept = [l for l in lines if l.split("=", 1)[0] not in drop]
body = "\n".join(kept + [f"{k}={v}" for k, v in updates.items()]) + "\n"
fd = os.open(str(ENV), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write(body)
# O_CREAT's mode applies only on creation, and .env always already exists here,
# so enforce the permission explicitly rather than assuming it carried over.
os.chmod(str(ENV), 0o600)

# Report only WHICH SOURCE won, never any part of any value.
def source(kept, supplied):
    if kept:
        return "kept-learner-key"
    return "solve-key" if supplied else "absent"


print("seed_credentials: langsmith=%s endpoint=%s" % (
    source(ls_kept, ls_real),
    (source(ep_kept, ep_real) if (ep_kept or ep_real) else "default-us")
    if (ls_kept or ls_real) else "none"))
