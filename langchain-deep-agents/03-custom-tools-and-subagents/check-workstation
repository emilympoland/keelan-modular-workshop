#!/bin/bash
#
# Check — challenge 3 (custom-tools-and-subagents)
#
# No strict set flags (house default): every probe is handled explicitly so the
# fail-message always reaches the learner instead of the script dying on an
# unset variable.
#
# The pass condition is LIVE: a trace in the learner's own project named
# 'custom-tools-and-subagents'. It deliberately does not require a
# web_search call: whether the model searches is its own choice.
#
# Without a LangSmith key, check_custom_tools_subagents.py looks for the same
# run in the local trace files utils/models.py writes (/var/lib/lab-traces/).
#
# Time budget: one bounded LangSmith query. Well inside the ~60s ceiling; a
# killed check never shows its message.

_fail() {
  fail-message "$1" 2>/dev/null || echo "FAIL: $1" >&2
  exit 1
}

ENV_FILE=/opt/workshop/.env
VENV_PY=/opt/workshop/.venv/bin/python

if [ ! -f "$ENV_FILE" ]; then
  _fail "Setup hasn't finished yet. Wait a moment and click Check again."
fi

# [Check 1/2] challenge 1's key cell ran (keys entered or skipped -- both work).
# Worded gently: skipping is enabled, and a Skip runs challenge 1's solve,
# which records this too.
if [ ! -f /tmp/.credentials-ok ]; then
  _fail "[Check 1/2] Run the first cell of 01_setup.ipynb first. Enter your keys, or press Enter to skip them."
fi

# [Check 2/2] the live assertion: the learner's agent ran.
timeout --kill-after=3 50 "$VENV_PY" /opt/instruqt-workshop/check_custom_tools_subagents.py
rc=$?

case "$rc" in
  0)
    exit 0
    ;;
  2)
    _fail "[Check 2/2] Your notebook ran, but no traces have reached LangSmith. Traces lag a few seconds — wait and click Check again."
    ;;
  3)
    _fail "[Check 2/2] No run named 'custom-tools-and-subagents' in your traces. Run the 'Run it' cell."
    ;;
  124 | 137)
    _fail "[Check 2/2] LangSmith didn't answer in time. Usually a slow moment, not your work — click Check again."
    ;;
  *)
    _fail "[Check 2/2] Couldn't read your traces from LangSmith. Re-run the last cell of 01_setup.ipynb to confirm the connection, then click Check again."
    ;;
esac
