#!/bin/bash
#
# Solve — challenge 3 (custom-tools-and-subagents)
#
# This challenge has one genuinely blank cell (uncomment `tools=` and
# `subagents=`), so the learner's notebook cannot simply be executed: as
# shipped, both lines are commented out and the agent has neither. So the
# solve fills the blank first, by cell TAG, writing a copy to /tmp — the
# learner's own notebook is never modified. Executing that copy for real is
# still the only automated proof that every other cell in the notebook runs,
# and that the filled cell is a correct solution.
#
# Full-chain defensive: skipping is enabled, so this may run without earlier
# challenges having been played. It seeds credentials first — a real
# SOLVE_TAVILY_API_KEY matters here more than anywhere before it: without one,
# resilient_tavily_search falls back to canned content, and the check
# correctly reports that as a dead key (exit 7), not a pass.
#
# Idempotent: re-running refills the blank and re-executes, overwriting the
# same real output.
#
# Adapted from the sibling track langchain-langgraph-langsmith-ext
# (04-the-five-line-version), same fill-by-tag-then-execute-from-/tmp pattern.
set -euo pipefail

WORKSHOP_DIR=/opt/workshop
OPS_DIR=/opt/instruqt-workshop
VENV_BIN="${WORKSHOP_DIR}/.venv/bin"

# --- credentials, exactly as challenge 1's getpass cell would leave them ----- #
"${VENV_BIN}/python" "${OPS_DIR}/seed_credentials.py"

# --- fill the blanked cell -------------------------------------------------- #
"${VENV_BIN}/python" "${OPS_DIR}/fill_challenge3_blank.py"

# --- run the filled notebook ------------------------------------------------ #
# Executed from /tmp, which is why this notebook's Setup cell uses an absolute
# path rather than upstream's cwd-relative Path().resolve().parent: nbconvert
# runs the kernel in the input notebook's own directory.
#
# A delegated run is a full agent run of its own (the research-agent's), so
# the timeout budget is larger than challenge 2's.
cd /tmp
timeout --kill-after=10 600 "${VENV_BIN}/jupyter" nbconvert \
  --to notebook \
  --execute \
  --ExecutePreprocessor.timeout=360 \
  --output-dir /tmp \
  --output 03_custom_tools_and_subagents.executed.ipynb \
  /tmp/03_custom_tools_and_subagents.solved.ipynb

echo "solve: challenge 3 blank filled and notebook executed end to end"
