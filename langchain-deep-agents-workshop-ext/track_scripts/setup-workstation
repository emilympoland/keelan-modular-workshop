"""Assert, from LangSmith, that the learner's agent wrote a file.

The Checks run outside the notebook kernel, so they can't see the agent's
virtual filesystem. The trace can: every write_file tool run records its
file_path and content. So instead of copying files to disk for the Check,
read what the agent did straight from the learner's own project.

  check_trace.py --path /haiku.txt
                 [--after-resume]          write must be in a resumed (HITL) run
                 [--prompt-contains TEXT]  repeatable; text the model must see

  0 ok
  2 nothing traced yet (traces lag a few seconds)
  6 no successful write_file to --path
  7 the write ran without a HITL pause (interrupt_on not active)
  8 a --prompt-contains marker never reached the model
 10 could not reach LangSmith
"""
import argparse
import os
import sys
from datetime import datetime, timedelta, timezone

from dotenv import load_dotenv

load_dotenv("/opt/workshop/.env", override=True)
from langsmith import Client

ap = argparse.ArgumentParser()
ap.add_argument("--path", required=True)
ap.add_argument("--after-resume", action="store_true")
ap.add_argument("--prompt-contains", action="append", default=[])
args = ap.parse_args()

project = os.environ["LANGSMITH_PROJECT"]
since = datetime.now(timezone.utc) - timedelta(hours=6)


def written_path(run):
    inputs = run.inputs or {}
    return inputs.get("file_path") or inputs.get("path")


try:
    client = Client()
    writes = list(client.list_runs(
        project_name=project, run_type="tool", start_time=since,
        filter='eq(name, "write_file")',
        select=["id", "name", "trace_id", "inputs", "error", "start_time"],
        limit=100,
    ))
except Exception as e:
    # Never print the error body: a credential failure can echo the key back.
    print("check_trace: %s" % type(e).__name__, file=sys.stderr)
    sys.exit(10)

if not writes:
    try:
        anything = next(iter(client.list_runs(project_name=project, start_time=since, limit=1)), None)
    except Exception:
        anything = None
    sys.exit(6 if anything else 2)

mine = [w for w in writes
        if written_path(w) == args.path and not w.error and (w.inputs or {}).get("content")]
if not mine:
    sys.exit(6)

# Newest first: a learner who fixed their code and re-ran should be judged on
# the latest run, not an earlier broken one.
mine.sort(key=lambda r: r.start_time, reverse=True)

try:
    if args.after_resume:
        # A HITL-approved write runs inside the RESUMED invoke, whose root input
        # is Command(resume=...). Without interrupt_on, the write lands in the
        # first invoke instead, whose root input is the user's message.
        resumed = [w for w in mine if "resume" in str(client.read_run(w.trace_id).inputs)]
        if not resumed:
            sys.exit(7)
        mine = resumed

    if args.prompt_contains:
        target = mine[0]
        llm_inputs = " ".join(
            str(r.inputs) for r in client.list_runs(
                project_name=project, trace_id=target.trace_id, run_type="llm",
                select=["id", "inputs"],
            )
        )
        if not all(marker in llm_inputs for marker in args.prompt_contains):
            sys.exit(8)
except SystemExit:
    raise
except Exception as e:
    print("check_trace: %s" % type(e).__name__, file=sys.stderr)
    sys.exit(10)

print("Confirmed in LangSmith: write_file %s (trace %s)." % (args.path, mine[0].trace_id))
sys.exit(0)
