#!/bin/bash
#
# Track-level setup — langchain-deep-agents-workshop-ext
#
# Provisions the workshop environment on the workstation VM:
#   repo (pinned) + uv venv, Bedrock model wiring, setup notebook,
#   JupyterLab behind nginx (systemd), Bedrock warm-up.
#
# The track provides NO LangSmith or Tavily credentials: learners enter their
# own in challenge 1. The only credential here is the per-sandbox AWS account
# Instruqt provisions for Bedrock.
#
# Infra conventions lifted from the sibling track
# langchain-langgraph-langsmith-ext (git branch adlc-101-slice-0). AgentCore
# Web Search was tried and rejected as the section-3 web-search tool -- see
# MEMORY.md, slice 0 verdict: blocked by an AWS Organizations SCP deny.
#
set -euxo pipefail
PS4='+$0[$LINENO]+'

echo "##################################################"
echo "# running track_scripts/setup-workstation        #"
echo "##################################################"

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export HOME=/root

# The workshop tree lives in /opt/workshop, owned by the non-root 'workshop'
# user that runs JupyterLab. /root/workshop is a compatibility symlink so every
# path used by checks, solves, and notebooks keeps working.
WORKSHOP_DIR=/opt/workshop
WORKSHOP_USER=workshop
INSTRUQT_DIR="${WORKSHOP_DIR}/instruqt"
OPS_DIR=/opt/instruqt-workshop
ENV_FILE=/etc/instruqt-workshop.env

# ---------------------------------------------------------------- #
echo "⏳ Step 1/10: waiting for host bootstrap + agent..."
tries=0
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  tries=$((tries+1)); [ "$tries" -ge 300 ] && { echo "SETUP FAILED: bootstrap sentinel absent after 300s" >&2; exit 1; }
  sleep 1
done
tries=0
until ss -tuln 2>/dev/null | grep -q ':15779'; do
  tries=$((tries+1)); [ "$tries" -ge 120 ] && { echo "SETUP FAILED: instruqt agent port 15779 not up after 120s" >&2; exit 1; }
  sleep 1
done
echo "✅ Step 1/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 2/10: base packages..."
wait_for_dpkg() {
  local t=0
  while fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock >/dev/null 2>&1; do
    t=$((t+1)); [ "$t" -ge 150 ] && { echo "SETUP FAILED: dpkg lock held >300s" >&2; exit 1; }
    sleep 2
  done
}
wait_for_dpkg
apt-get update -qq
wait_for_dpkg
apt-get install -y -qq git jq curl unzip nginx
touch /root/.hushlogin

# Non-root service account for JupyterLab (no login shell, so Jupyter's
# terminal feature is dead weight even if reached).
id -u "$WORKSHOP_USER" >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin "$WORKSHOP_USER"
echo "✅ Step 2/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 3/10: per-sandbox identity + agent variables..."
# The sandbox id is the uniqueness guarantee: Instruqt documents
# INSTRUQT_PARTICIPANT_ID (which _SANDBOX_ID mirrors) as unique for every play.
#
# It is NOT attributable, though, which matters when a room shares one LangSmith
# workspace. Instruqt's INSTRUQT_USER_NAME / INSTRUQT_USER_EMAIL would solve
# that, but both are gated on the user having accepted the org's privacy policy
# and team `langchain` has none configured -- a real playthrough on 2026-09-16
# showed both EMPTY with PRIVACY_POLICY_CONSENT unset, so no track-side code can
# reach them. The learner supplies their own label in challenge 1 instead, which
# is also the only option that works for external customers. See MEMORY.md.
SFX="$(echo "${_SANDBOX_ID:-localdev0}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9' | cut -c1-8)"
[ -n "$SFX" ] || SFX="localdev"
LS_PROJECT="${LANGSMITH_PROJECT_BASE:-instruqt-deep-agents}-${SFX}"

agent variable set SFX "$SFX"
agent variable set LS_PROJECT "$LS_PROJECT"
echo "✅ Step 3/10 completed (suffix: ${SFX})"

echo "⏳ Step 4/10: clone modular-workshops @ pinned commit..."
# Pinned to WORKSHOP_COMMIT (config.yml) so upstream changes never break a
# workshop that is already running.
rm -rf "$WORKSHOP_DIR"
mkdir -p "$WORKSHOP_DIR"
cd "$WORKSHOP_DIR"
git init -q
git remote add origin "${WORKSHOP_REPO}"
tries=0
until git fetch --depth 1 origin "${WORKSHOP_COMMIT}"; do
  tries=$((tries+1)); [ "$tries" -ge 5 ] && { echo "SETUP FAILED: could not fetch pinned commit from GitHub" >&2; exit 1; }
  sleep 5
done
git checkout -q FETCH_HEAD
mkdir -p "${WORKSHOP_DIR}/output" "$INSTRUQT_DIR" "$OPS_DIR"
# Compatibility symlink: /root/workshop → /opt/workshop
[ -L /root/workshop ] || rm -rf /root/workshop
ln -sfn "$WORKSHOP_DIR" /root/workshop
# The non-root 'workshop' user (Jupyter kernels) must traverse /root to reach
# that symlink. 711 allows traverse-by-known-name only — no directory listing,
# and the sensitive files under /root (.aws/credentials, .ssh keys) stay 600
# and unreadable.
chmod 711 /root
echo "✅ Step 4/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 5/10: uv + python environment (uv sync)..."
# The pinned commit's pyproject.toml already carries every dependency this
# track needs (langgraph, langgraph-checkpoint-sqlite, jupyter, langchain-aws,
# tavily-python, python-dotenv), so a plain `uv sync` is sufficient — no
# supplementary installs that could drift from upstream.
if ! command -v uv >/dev/null 2>&1 && [ ! -x /root/.local/bin/uv ]; then
  tries=0
  until curl -LsSf https://astral.sh/uv/install.sh | sh; do
    tries=$((tries+1)); [ "$tries" -ge 3 ] && { echo "SETUP FAILED: uv install failed 3x" >&2; exit 1; }
    sleep 5
  done
fi
export PATH="/root/.local/bin:$PATH"
cd "$WORKSHOP_DIR"
tries=0
until uv sync; do
  tries=$((tries+1)); [ "$tries" -ge 3 ] && { echo "SETUP FAILED: uv sync failed 3x" >&2; exit 1; }
  sleep 10
done
VENV_PY="${WORKSHOP_DIR}/.venv/bin/python"
echo "✅ Step 5/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 6/10: credentials + environment files..."
# Resolve Bedrock AWS creds; fall back to any injected AWS-account prefix.
BEDROCK_AWS_KEY="${INSTRUQT_AWS_ACCOUNT_BEDROCK_AWS_ACCESS_KEY_ID:-}"
BEDROCK_AWS_SECRET="${INSTRUQT_AWS_ACCOUNT_BEDROCK_AWS_SECRET_ACCESS_KEY:-}"
if [ -z "$BEDROCK_AWS_KEY" ]; then
  key_var="$(env | grep -oE '^INSTRUQT_AWS_ACCOUNT_[A-Z0-9_]+_AWS_ACCESS_KEY_ID' | head -n1 || true)"
  if [ -n "$key_var" ]; then
    secret_var="${key_var%_AWS_ACCESS_KEY_ID}_AWS_SECRET_ACCESS_KEY"
    BEDROCK_AWS_KEY="${!key_var}"
    BEDROCK_AWS_SECRET="${!secret_var}"
  fi
fi
[ -n "$BEDROCK_AWS_KEY" ] || { echo "SETUP FAILED: no injected AWS credentials found for Bedrock" >&2; exit 1; }
# No LangSmith or Tavily key is expected here: the learner supplies their own in
# challenge 1, and the getpass cell appends them to the .env written below.

# Secrets go into files, never into the xtrace log.
set +x
mkdir -p /root/.aws
cat > /root/.aws/credentials <<AWSEOF
[default]
aws_access_key_id = ${BEDROCK_AWS_KEY}
aws_secret_access_key = ${BEDROCK_AWS_SECRET}
AWSEOF
cat > /root/.aws/config <<AWSCFGEOF
[default]
region = ${BEDROCK_REGION}
AWSCFGEOF
chmod 600 /root/.aws/credentials

# Workshop .env — loaded by utils/models.py (dotenv) and every notebook.
#
# Ships WITHOUT LangSmith or Tavily keys: the learner adds those in challenge 1
# and the getpass cell rewrites this file in place. Tracing starts off, so the
# tracer doesn't emit errors against a key that doesn't exist yet; the same cell
# flips it on once a key has authenticated.
#
# No LANGSMITH_WORKSPACE_ID either — the learner's key belongs to their own
# workspace, and scoping clients to ours would make every call forbidden.
cat > "${WORKSHOP_DIR}/.env" <<DOTENVEOF
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=${LS_PROJECT}
WORKSHOP_SFX=${SFX}
WORKSHOP_PROJECT_BASE=${LANGSMITH_PROJECT_BASE:-instruqt-deep-agents}
AWS_ACCESS_KEY_ID=${BEDROCK_AWS_KEY}
AWS_SECRET_ACCESS_KEY=${BEDROCK_AWS_SECRET}
AWS_DEFAULT_REGION=${BEDROCK_REGION}
BEDROCK_MODEL_SONNET=${BEDROCK_MODEL_SONNET}
BEDROCK_MODEL_HAIKU=${BEDROCK_MODEL_HAIKU}
DOTENVEOF
chmod 600 "${WORKSHOP_DIR}/.env"

# Same content for systemd services + interactive shells.
cp "${WORKSHOP_DIR}/.env" "$ENV_FILE"
# Per-sandbox JupyterLab token (ENV_FILE only — not in the learner-visible
# .env). nginx injects it for tab traffic; Jupyter refuses anything without it.
JUPYTER_TOKEN="$(openssl rand -hex 24)"
echo "JUPYTER_TOKEN=${JUPYTER_TOKEN}" >> "$ENV_FILE"
chmod 600 "$ENV_FILE"
cat >> /root/.bashrc <<'BASHRCEOF'
set -a; [ -f /etc/instruqt-workshop.env ] && . /etc/instruqt-workshop.env; set +a
export PATH="/root/.local/bin:/root/workshop/.venv/bin:$PATH"
BASHRCEOF
set -x

# ---- Bedrock credential preflight --------------------------------- #
# The model is the only credential the TRACK provides, so it is the only one
# that can be validated here. The learner's LangSmith and Tavily keys are
# validated at the moment they are entered, in the challenge-1 notebook cell.
cat > "${OPS_DIR}/preflight_bedrock.py" <<'PREEOF'
"""Fail fast if the sandbox's injected AWS credentials cannot reach Bedrock."""
import os, sys
from dotenv import load_dotenv
load_dotenv("/root/workshop/.env", override=True)
sys.path.insert(0, "/root/workshop")

try:
    from utils.models import model
    model.invoke("Reply with the single word: ready")
except Exception as exc:
    print("SETUP FAILED: Bedrock credential preflight", file=sys.stderr)
    print("  The sandbox's AWS credentials could not invoke the model.", file=sys.stderr)
    print(f"  region: {os.environ.get('AWS_DEFAULT_REGION')}", file=sys.stderr)
    print(f"  model:  {os.environ.get('BEDROCK_MODEL_SONNET')}", file=sys.stderr)
    print(f"  API said: {str(exc)[:200]}", file=sys.stderr)
    sys.exit(1)
print("\u2713 preflight OK \u2014 Bedrock reachable with the sandbox's AWS credentials")
PREEOF
# Guarded: Bedrock model access can take minutes to finish enabling in a fresh
# sandbox, so a failure here is reported by the warm-up retry loop in step 10
# rather than killing setup on the first attempt.
"$VENV_PY" "${OPS_DIR}/preflight_bedrock.py" || echo "preflight: Bedrock not ready yet — step 10 retries with backoff"
echo "✅ Step 6/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 7/10: point utils/models.py at Bedrock..."
# Deterministic overwrite (not sed) — same public interface: `model`.
# This is also what resolves the import-time credential problem: the module
# that reads the environment is replaced wholesale.
cat > "${WORKSHOP_DIR}/utils/models.py" <<'MODELSEOF'
"""Centralized model initialization (Instruqt build).

The notebooks all import `model` from here. This build runs on AWS Bedrock
using the sandbox's ephemeral AWS credentials — the documented one-line
provider swap from the upstream repo, applied.
"""

import os
from dotenv import load_dotenv
load_dotenv(dotenv_path="../.env", override=True)
load_dotenv(dotenv_path="/root/workshop/.env", override=False)

from langchain_aws import ChatBedrockConverse

_REGION = os.environ.get("AWS_DEFAULT_REGION", "us-east-1")

# Agent model — Claude Sonnet via Bedrock cross-region inference.
model = ChatBedrockConverse(
    provider="anthropic",
    model_id=os.environ.get("BEDROCK_MODEL_SONNET", "us.anthropic.claude-sonnet-4-6"),
    region_name=_REGION,
)

# Judge model — Claude Haiku, for fast/cheap evaluation work.
judge_model = ChatBedrockConverse(
    provider="anthropic",
    model_id=os.environ.get("BEDROCK_MODEL_HAIKU", "us.anthropic.claude-haiku-4-5-20251001-v1:0"),
    region_name=_REGION,
)
MODELSEOF
echo "✅ Step 7/10 completed"

# ---------------------------------------------------------------- #
echo "⏳ Step 8/10: workshop content (verify script, orientation notebook)..."

# ---- verify-connection (challenge 1) ----
# Reads whatever key the learner stored via the notebook's getpass cell.
# Prints NO part of the key — the PRD forbids any secret value, even a prefix,
# in learner-facing output.
cat > "${OPS_DIR}/verify_connection.py" <<'VERIFYEOF'
"""Challenge 1 — verify the LangSmith connection, live."""
import os, sys
from dotenv import load_dotenv
load_dotenv("/root/workshop/.env", override=True)
from langsmith import Client

ACCENT = "\033[38;2;127;200;255m"; OK = "\033[38;2;2;122;72m"
ERR = "\033[38;2;180;35;24m"; RST = "\033[0m"

def fail(msg):
    print(f"{ERR}✗ {msg}{RST}"); sys.exit(1)

print(f"{ACCENT}── LangSmith connection check ─────────────────────{RST}")
key = os.environ.get("LANGSMITH_API_KEY", "")
if not key:
    fail("No LangSmith key stored yet. Run the first cell of 01_setup.ipynb on the Notebook tab.")
if not key.startswith("lsv2_"):
    fail("The stored LANGSMITH_API_KEY is malformed — LangSmith keys start with 'lsv2_'.")
print(f"{OK}✓{RST} API key present (value masked)")

ENDPOINT = os.environ.get("LANGSMITH_ENDPOINT", "https://api.smith.langchain.com")
REGION = {
    "https://api.smith.langchain.com": "US",
    "https://eu.api.smith.langchain.com": "EU",
    "https://apac.api.smith.langchain.com": "APAC",
    "https://aws.api.smith.langchain.com": "AWS US",
}.get(ENDPOINT, "custom")

# An AUTHENTICATED call. Client().info is not one -- /info answers 200 for any
# key at all, so the old check here passed for a garbage key and for a valid key
# pointed at the wrong region.
try:
    import itertools
    list(itertools.islice(Client().list_projects(), 1))
except Exception:
    # Never print the exception body: a rejected-credential error can echo the
    # submitted value back.
    fail(f"LangSmith rejected the stored key against the {REGION} region "
         f"({ENDPOINT}). Re-run the first notebook cell to enter it again.")
print(f"{OK}✓{RST} {ENDPOINT.replace('https://','')} authenticated ({REGION} region)")

print(f"{OK}✓{RST} tracing project: {os.environ.get('LANGSMITH_PROJECT', '')}")
print(f"{OK}✓{RST} tracing enabled: {os.environ.get('LANGSMITH_TRACING')}")
if os.environ.get("TAVILY_API_KEY"):
    print(f"{OK}✓{RST} Tavily key present (value masked)")
else:
    print("• Tavily key not set — not needed for this challenge")
print(f"{ACCENT}───────────────────────────────────────────────────{RST}")
print("Connected. Every agent you build in this track traces into that")
print("project in your own LangSmith workspace.")
with open("/tmp/.verify-connection-ok", "w") as f:
    f.write("ok\n")
# Mode 666: this runs as root, but the same sentinel may later be rewritten by
# the non-root account that runs the Jupyter kernel.
os.chmod("/tmp/.verify-connection-ok", 0o666)
VERIFYEOF
cat > /usr/local/bin/verify-connection <<'WRAPEOF'
#!/bin/bash
cd /root/workshop && exec .venv/bin/python /opt/instruqt-workshop/verify_connection.py "$@"
WRAPEOF
chmod +x /usr/local/bin/verify-connection

# ---- orientation notebook (challenge 1) ----
# Slice 0 carries no LangGraph teaching content. This notebook collects the
# learner's own credentials, then proves the path end to end: Jupyter serves,
# the kernel starts in the workshop venv, Bedrock answers, and the call traces.

cat > "${INSTRUQT_DIR}/lab_state.py" <<'STATEEOF'
"""Tiny helper: record that a notebook cell really ran, for the challenge Check."""

import os
from pathlib import Path


def mark_done(path):
    """Write a sentinel the Check reads, tolerating one root already left there."""
    p = Path(path)
    try:
        p.write_text("ok\n")
    except PermissionError:
        # Skipping a challenge runs its solve as root, which creates these
        # files; /tmp is sticky so we cannot replace one we do not own. If it
        # is already present with content, the Check is satisfied either way.
        if not (p.exists() and p.read_text().strip()):
            raise
        return
    try:
        os.chmod(p, 0o666)  # let root-side scripts rewrite it later
    except OSError:
        pass

STATEEOF

cat > "${INSTRUQT_DIR}/lab_credentials.py" <<'CREDEOF'
"""Collect the learner's API keys in Challenge 1 and store them in .env.

Plumbing, deliberately kept out of the notebook: nobody is here to learn
getpass. The notebook cell is just `from lab_credentials import collect`.
"""

import getpass
import os
import re
import unicodedata
from pathlib import Path

from lab_state import mark_done

ENV = Path("/root/workshop/.env")

# LangSmith is regional and a key is only valid in its own region. The region is
# NOT encoded in the key -- `lsv2_sk_` vs `lsv2_pt_` is service-key vs personal
# token, not US vs EU -- so the only way to know is to ask each region in turn.
REGIONS = [
    ("US", "https://api.smith.langchain.com"),
    ("EU", "https://eu.api.smith.langchain.com"),
    ("APAC", "https://apac.api.smith.langchain.com"),
    ("AWS US", "https://aws.api.smith.langchain.com"),
]


def _detect_region(api_key):
    """First region where the key really authenticates, as (label, endpoint).

    Uses list_projects rather than Client().info: /info is UNAUTHENTICATED and
    returns 200 for any key at all, including a garbage one, so it cannot tell
    a good key from a bad one, or the right region from the wrong one.
    """
    import itertools

    from langsmith import Client

    for label, url in REGIONS:
        try:
            client = Client(api_key=api_key, api_url=url)
            list(itertools.islice(client.list_projects(), 1))
        except Exception:
            # Never inspect or print the body: a rejected-credential response
            # can echo the submitted key back, and notebook output is saved to
            # disk. Failures here are the ordinary wrong-region path.
            continue
        return label, url
    return None, None


def _slugify(text):
    """Strip accents and punctuation so a label is safe inside a project name."""
    plain = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "", plain.lower())[:20]


def _store(updates):
    """Rewrite .env in place at 0600, preserving every unrelated line."""
    lines = ENV.read_text().splitlines() if ENV.exists() else []
    kept = [l for l in lines if l.split("=", 1)[0] not in updates]
    body = "\n".join(kept + [f"{k}={v}" for k, v in updates.items()]) + "\n"
    fd = os.open(str(ENV), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    # The mode above only applies when the file is CREATED. .env already exists
    # (setup writes it), so without this an earlier bad mode would survive every
    # rewrite. Enforce it on the file we just wrote.
    os.chmod(str(ENV), 0o600)


def _project_name(label):
    sfx = os.environ.get("WORKSHOP_SFX", "")
    base = os.environ.get("WORKSHOP_PROJECT_BASE", "instruqt-deep-agents")
    if label and sfx:
        return f"{base}-{label}-{sfx}"
    if sfx:
        return f"{base}-{sfx}"
    return os.environ["LANGSMITH_PROJECT"]


def collect():
    """Prompt for keys, verify the LangSmith one live, and switch tracing on."""
    ls_key = getpass.getpass("LangSmith API key (input hidden): ").strip()
    if not ls_key.startswith("lsv2_"):
        raise SystemExit(
            "That doesn't look like a LangSmith key - they start with 'lsv2_'. "
            "Re-run this cell."
        )

    os.environ["LANGSMITH_API_KEY"] = ls_key

    print("Checking your key against each LangSmith region...")
    region, endpoint = _detect_region(ls_key)
    if endpoint is None:
        raise SystemExit(
            "That key did not authenticate in any LangSmith region "
            "(US, EU, APAC, AWS US). Check it and re-run this cell."
        )

    # Every LangSmith client in this track is a bare Client(), which reads this
    # variable from the environment -- so storing it here is what points the
    # tracer, verify-connection and all six Checks at your region.
    updates = {
        "LANGSMITH_API_KEY": ls_key,
        "LANGSMITH_TRACING": "true",
        "LANGSMITH_ENDPOINT": endpoint,
    }

    tv_key = getpass.getpass(
        "Tavily API key (input hidden, or press Enter to skip): "
    ).strip()
    if tv_key:
        updates["TAVILY_API_KEY"] = tv_key
        os.environ["TAVILY_API_KEY"] = tv_key

    # Not a secret, so unlike the keys above this one is echoed as it is typed.
    label = _slugify(input("Short name or initials for your project (e.g. jdoe): "))
    project = _project_name(label)
    updates["LANGSMITH_PROJECT"] = project

    _store(updates)
    os.environ["LANGSMITH_TRACING"] = "true"
    # The kernel started before this project name existed, so set it explicitly
    # -- every trace from here on reads the name from the environment.
    os.environ["LANGSMITH_PROJECT"] = project
    os.environ["LANGSMITH_ENDPOINT"] = endpoint
    mark_done("/tmp/.credentials-ok")

    print("✅ Keys verified and stored. Tracing is ON.")
    print("   region :", region)
    print("   project:", project)
    print("   tavily :", "set" if tv_key else "skipped (needed from Challenge 3)")
    if not label:
        print("   (no label given, so your project is named after this session)")
CREDEOF

# ---- trace-link helper shared by the notebooks ----
# Plumbing extracted from the notebooks (PRD 2026-09-22, "hide plumbing, never
# hide curriculum"): the region->UI-host mapping and the tracer flush are not
# what anyone is here to learn, and they were being restated in every notebook
# that printed a project link.
cat > "${INSTRUQT_DIR}/lab_trace.py" <<'TRACEEOF'
"""Print the link to this sandbox's LangSmith project, and what to open there."""

import os

from langchain_core.tracers.langchain import wait_for_all_tracers
from langsmith import Client


def project_link(run_name=None, expand=None):
    """Print the project URL. Name a run to say which one to open."""
    # Push any queued spans before we go looking for them. NOTE this flushes the
    # client queue; it is not a read-after-write barrier -- LangSmith is still
    # eventually consistent, which is why the Checks retry.
    wait_for_all_tracers()

    # The UI host mirrors the API host for your region -- api.smith -> smith,
    # eu.api.smith -> eu.smith, and so on. Dropping "api." is the whole mapping.
    # `or` rather than a get() default: the variable is always PRESENT in the
    # sandbox, and is empty for a US-region key, which a default never catches.
    api = os.environ.get("LANGSMITH_ENDPOINT") or "https://api.smith.langchain.com"
    ui = api.replace("api.smith", "smith")
    project = os.environ["LANGSMITH_PROJECT"]

    try:
        p = Client().read_project(project_name=project)
        print("Your traces:")
        print(f"  {ui}/o/{p.tenant_id}/projects/p/{p.id}")
    except Exception:
        # Never print the error body: a credential failure can echo the key back.
        print(f"Open {ui} and choose project:", project)

    if run_name:
        print()
        print(f"Open '{run_name}'" + (f" and expand '{expand}'." if expand else "."))


def trace_link(run_id):
    """Print the URL of one trace. Pass the run_id given to invoke() in config."""
    wait_for_all_tracers()

    api = os.environ.get("LANGSMITH_ENDPOINT") or "https://api.smith.langchain.com"
    ui = api.replace("api.smith", "smith")
    project = os.environ["LANGSMITH_PROJECT"]

    try:
        p = Client().read_project(project_name=project)
        # ?poll=true: the page waits for the trace if it hasn't landed yet.
        print(f"\nView the trace: {ui}/o/{p.tenant_id}/projects/p/{p.id}/r/{run_id}?poll=true")
    except Exception:
        # Never print the error body: a credential failure can echo the key back.
        print(f"\nOpen {ui} and choose project:", project)
TRACEEOF

cat > "${OPS_DIR}/gen_notebooks.py" <<'GENEOF'
"""Generate the track's notebooks (stdlib JSON — a notebook is just JSON)."""
import json, os

OUT = "/opt/workshop/instruqt"

